# Southline AI Receptionist — webhook environment
# Copy this file to ".env" and fill in your real values. NEVER commit the real .env.

# --- Twilio (to text leads to the owner). Get these at console.twilio.com ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+353xxxxxxxxx

# Fallback owner number if an assistant has no ownerPhone in its metadata.
DEFAULT_OWNER_PHONE=+3538xxxxxxxx

# Port the webhook listens on (default 3000)
PORT=3000

# --- Google Calendar booking (optional — leave blank to run in demo mode) ---
# 1. Google Cloud Console -> enable "Google Calendar API"
# 2. Create a Service Account -> create a JSON key
# 3. In the client's Google Calendar -> Share -> add the SA email -> "Make changes to events"
GOOGLE_CALENDAR_ID=the-clients-calendar-id@group.calendar.google.com
GOOGLE_SA_EMAIL=receptionist@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key. Keep the \n escapes on one line.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
TIMEZONE=Europe/Dublin
OPEN_HOUR=9
CLOSE_HOUR=17
SLOT_MINS=30
# Days the business takes bookings (3-letter names, comma-separated)
OPEN_DAYS=Mon,Tue,Wed,Thu,Fri
# Optional daily break — no bookings between these hours (e.g. 13 and 14 = 1-2pm)
#LUNCH_START=13
#LUNCH_END=14
# Optional gap kept free around existing appointments, in minutes
#BUFFER_MINS=15

# --- Client logins (CRM) ---
# JSON array of accounts (create with scripts/create-client-account.js). Optional —
# sign-up accounts are stored automatically once they pay.
CLIENT_ACCOUNTS=[]

# --- Owner admin page (admin/ + the desktop app) ---
# The single password that unlocks the whole control centre. CHANGE THIS.
ADMIN_PASSWORD=change-me-to-something-long

# --- Sign-up & subscription (Stripe), tiered ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
DASHBOARD_URL=https://orourkeryan88-byte.github.io/relier-/receptionist/dashboard/

# One plan: €350 setup + €80/month (in cents). Override to change live pricing.
SETUP_FEE_CENTS=35000
MONTHLY_FEE_CENTS=8000
