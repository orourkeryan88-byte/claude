# Email notification sent the instant a chatbot lead comes in (see server.js -> notifyLead)
# Sign up free at https://resend.com, create an API key, paste it below.
RESEND_API_KEY=

# Where the notification email goes
NOTIFY_EMAIL=agencysouthline@gmail.com

# Sender shown on the email. The default below uses Resend's shared test domain,
# which works without verifying your own domain.
NOTIFY_FROM=Southline Leads <onboarding@resend.dev>
