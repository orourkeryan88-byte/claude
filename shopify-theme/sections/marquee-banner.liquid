<div class="marquee-banner">
  <div class="marquee-track">
    {%- assign items = section.settings.text | split: '|' -%}
    {%- for item in items -%}
      <span>{{ item | strip }}</span><span class="dot">✦</span>
    {%- endfor -%}
    {%- for item in items -%}
      <span>{{ item | strip }}</span><span class="dot">✦</span>
    {%- endfor -%}
    {%- for item in items -%}
      <span>{{ item | strip }}</span><span class="dot">✦</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Banner",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Items (separate with |)",
      "default": "RELIER|SS26|CONNECT TO THE CULTURE|STREETWEAR"
    }
  ],
  "presets": [
    {
      "name": "Marquee Banner"
    }
  ]
}
{% endschema %}
