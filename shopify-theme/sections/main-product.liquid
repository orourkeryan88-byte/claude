{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_images = product.images -%}

<!-- Breadcrumb -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span>/</span>
  <a href="/collections/all">Shop</a>
  <span>/</span>
  <span>{{ product.title }}</span>
</nav>

<!-- Product Layout -->
<div class="product-layout" id="product-{{ product.id }}">

  <!-- Gallery -->
  <div class="product-gallery">
    <div class="product-gallery__main">
      <div class="product-gallery__main-img" id="mainImgWrap">
        {%- if product_images.size > 0 -%}
          <img
            id="mainProductImg"
            src="{{ product_images[0] | image_url: width: 1000 }}"
            alt="{{ product_images[0].alt | escape | default: product.title }}"
            style="width:100%;height:100%;object-fit:cover;display:block;"
            width="1000"
            height="1250">
        {%- else -%}
          <div class="product-gallery__main-img product-gallery__main-img--placeholder">
            <canvas id="productLogoCanvas"></canvas>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if product_images.size > 1 -%}
      <div class="product-gallery__thumbs" id="galleryThumbs">
        {%- for image in product_images -%}
          <button
            class="product-gallery__thumb{% if forloop.first %} product-gallery__thumb--active{% endif %}"
            data-src="{{ image | image_url: width: 1000 }}"
            data-alt="{{ image.alt | escape | default: product.title }}"
            aria-label="{{ image.alt | default: product.title }}">
            <img
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt | escape | default: product.title }}"
              style="width:100%;height:100%;object-fit:cover;display:block;"
              loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Product Info -->
  <div class="product-info">
    <div class="product-info__tag-row">
      {%- if product.tags contains 'new' -%}
        <span class="product-info__tag">NEW ARRIVAL</span>
      {%- elsif current_variant.available == false -%}
        <span class="product-info__tag" style="background:var(--grey-400);">SOLD OUT</span>
      {%- else -%}
        <span class="product-info__tag">IN STOCK</span>
      {%- endif -%}
      <span class="product-info__sku">SKU: {{ current_variant.sku | default: product.handle | upcase }}</span>
    </div>

    <h1 class="product-info__name">{{ product.title | upcase }}</h1>

    <p class="product-info__price" id="productPrice">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s style="color:var(--grey-400);">{{ current_variant.compare_at_price | money }}</s>&nbsp;
      {%- endif -%}
      {{ current_variant.price | money }}
    </p>

    {%- if product.description != blank -%}
      <div class="product-info__desc">{{ product.description }}</div>
    {%- endif -%}

    {%- form 'product', product, id: 'product-form', data-product-id: product.id -%}
      <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="product-option">
            {%- if option.name == 'Color' or option.name == 'Colour' -%}
              <p class="product-option__label">
                {{ option.name | upcase }}: <span id="selectedColour">{{ option.selected_value }}</span>
              </p>
              <div class="product-option__swatches">
                {%- for value in option.values -%}
                  {%- assign swatch_class = value | downcase | replace: ' ', '-' -%}
                  <button
                    type="button"
                    class="swatch swatch--{{ swatch_class }}{% if option.selected_value == value %} active{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value }}"
                    aria-label="{{ value }}"
                    title="{{ value }}">
                  </button>
                {%- endfor -%}
              </div>

            {%- elsif option.name == 'Size' -%}
              <p class="product-option__label">
                SIZE: <span id="selectedSize">{{ option.selected_value | default: 'Select Size' }}</span>
              </p>
              <div class="product-option__sizes">
                {%- for value in option.values -%}
                  {%- assign variant_for_size = product.variants | where: 'option1', value | first -%}
                  <button
                    type="button"
                    class="size-btn{% if variant_for_size.available == false %} size-btn--sold{% endif %}{% if option.selected_value == value %} active{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value }}"
                    {% if variant_for_size.available == false %}disabled aria-disabled="true"{% endif %}>
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
              <a href="/pages/size-guide" class="product-option__size-guide">Size Guide →</a>

            {%- else -%}
              <p class="product-option__label">{{ option.name | upcase }}</p>
              <div class="product-option__sizes">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="size-btn{% if option.selected_value == value %} active{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <!-- Add to Cart -->
      <div class="product-actions">
        <button
          type="submit"
          id="addToCart"
          class="btn btn--black btn--full"
          {% unless current_variant.available %}disabled style="opacity:0.5;cursor:not-allowed;"{% endunless %}>
          {%- if current_variant.available -%}
            ADD TO CART
          {%- else -%}
            SOLD OUT
          {%- endif -%}
        </button>
        <button type="button" class="btn btn--outline btn--icon" id="wishlistBtn" aria-label="Add to wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      </div>
    {%- endform -%}

    <!-- Shipping Info -->
    <div class="product-shipping">
      <div class="product-shipping__item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span>Free UK shipping on orders over £100</span>
      </div>
      <div class="product-shipping__item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.61"/>
        </svg>
        <span>Free returns within 14 days</span>
      </div>
      <div class="product-shipping__item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>Secure checkout</span>
      </div>
    </div>

    <!-- Accordion -->
    <div class="accordion">
      {%- if product.metafields.custom.details -%}
        <div class="accordion__item">
          <button class="accordion__trigger">
            <span>PRODUCT DETAILS</span>
            <span class="accordion__icon">+</span>
          </button>
          <div class="accordion__body">{{ product.metafields.custom.details }}</div>
        </div>
      {%- else -%}
        <div class="accordion__item">
          <button class="accordion__trigger">
            <span>PRODUCT DETAILS</span>
            <span class="accordion__icon">+</span>
          </button>
          <div class="accordion__body">
            <p>{{ product.description | strip_html | truncate: 300 }}</p>
          </div>
        </div>
      {%- endif -%}
      <div class="accordion__item">
        <button class="accordion__trigger">
          <span>SIZING &amp; FIT</span>
          <span class="accordion__icon">+</span>
        </button>
        <div class="accordion__body">
          {%- if product.metafields.custom.sizing -%}
            {{ product.metafields.custom.sizing }}
          {%- else -%}
            <p>For a true oversized look, size up one size. See our <a href="/pages/size-guide">size guide</a> for measurements.</p>
          {%- endif -%}
        </div>
      </div>
      <div class="accordion__item">
        <button class="accordion__trigger">
          <span>SHIPPING &amp; RETURNS</span>
          <span class="accordion__icon">+</span>
        </button>
        <div class="accordion__body">
          <p>Standard UK delivery 3–5 business days. Express 1–2 days. Free returns within 14 days. See our <a href="/pages/shipping-returns">full returns policy</a>.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- You May Also Like -->
{%- assign related = product.collections.first.products -%}
{%- if related.size > 1 -%}
  <section class="section">
    <div class="section__header">
      <h2 class="section__title">YOU MAY ALSO LIKE</h2>
    </div>
    <div class="product-grid product-grid--4">
      {%- for p in related limit: 4 -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p, lazy_load: true -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<script>
(function() {
  /* Gallery thumbnail switcher */
  var mainImg = document.getElementById('mainProductImg');
  var thumbsWrap = document.getElementById('galleryThumbs');

  if (thumbsWrap && mainImg) {
    thumbsWrap.querySelectorAll('.product-gallery__thumb').forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        mainImg.src = thumb.dataset.src;
        mainImg.alt = thumb.dataset.alt;
        thumbsWrap.querySelectorAll('.product-gallery__thumb').forEach(function(t) {
          t.classList.remove('product-gallery__thumb--active');
        });
        thumb.classList.add('product-gallery__thumb--active');
      });
    });
  }

  /* Variant selection */
  var productData = {{ product.variants | json }};
  var selectedOptions = {};

  document.querySelectorAll('[data-option-position]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var pos = this.dataset.optionPosition;
      var val = this.dataset.optionValue;
      selectedOptions[pos] = val;

      /* Update label text */
      var optionWrap = this.closest('.product-option');
      var labelSpan = optionWrap ? optionWrap.querySelector('[id^="selected"]') : null;
      if (labelSpan) labelSpan.textContent = val;

      /* Toggle active state in group */
      var siblings = document.querySelectorAll('[data-option-position="' + pos + '"]');
      siblings.forEach(function(s) { s.classList.remove('active'); });
      this.classList.add('active');

      /* Find matching variant */
      var matched = productData.find(function(v) {
        return Object.keys(selectedOptions).every(function(p) {
          return v['option' + p] === selectedOptions[p];
        });
      });

      if (matched) {
        document.getElementById('variantId').value = matched.id;
        var priceEl = document.getElementById('productPrice');
        if (priceEl) {
          priceEl.textContent = (matched.price / 100).toLocaleString('en-GB', {
            style: 'currency', currency: 'GBP'
          });
        }
        var addBtn = document.getElementById('addToCart');
        if (addBtn) {
          addBtn.disabled = !matched.available;
          addBtn.textContent = matched.available ? 'ADD TO CART' : 'SOLD OUT';
          addBtn.style.opacity = matched.available ? '' : '0.5';
          addBtn.style.cursor = matched.available ? '' : 'not-allowed';
        }
      }
    });
  });

  /* Add to cart form submission */
  var form = document.getElementById('product-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var variantId = document.getElementById('variantId').value;
      if (variantId) {
        relierAddToCart(variantId, 1);
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
