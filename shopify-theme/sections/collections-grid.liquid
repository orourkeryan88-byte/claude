<section class="section" id="collections">
  <div class="section__header">
    <h2 class="section__title">{{ section.settings.heading | default: 'COLLECTIONS' }}</h2>
  </div>

  <div class="collections-grid">
    {%- for block in section.blocks -%}
      {%- if forloop.index == 1 -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}"
           class="collection-card collection-card--tall" data-animate>
          <div class="collection-card__image{% unless block.settings.image %} collection-card__image--grey{% endunless %}">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}"
                   alt="{{ block.settings.label }}"
                   class="collection-card__bg-img"
                   loading="lazy">
            {%- endif -%}
            <canvas class="collection-logo-canvas"></canvas>
          </div>
          <div class="collection-card__overlay">
            <p class="collection-card__name">{{ block.settings.label | upcase }}</p>
            <span class="collection-card__arrow">→</span>
          </div>
        </a>
      {%- elsif forloop.index == 2 -%}
        <div class="collections-grid__right">
      {%- endif -%}

      {%- if forloop.index > 1 -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}"
           class="collection-card" data-animate>
          <div class="collection-card__image{% unless block.settings.image %} collection-card__image--dark{% endunless %}">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}"
                   alt="{{ block.settings.label }}"
                   class="collection-card__bg-img"
                   loading="lazy">
            {%- endif -%}
            <canvas class="collection-logo-canvas"></canvas>
          </div>
          <div class="collection-card__overlay">
            <p class="collection-card__name">{{ block.settings.label | upcase }}</p>
            <span class="collection-card__arrow">→</span>
          </div>
        </a>
      {%- endif -%}

      {%- if forloop.last and forloop.index > 1 -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections Grid",
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "TEES"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTIONS"
    }
  ],
  "presets": [
    {
      "name": "Collections Grid",
      "blocks": [
        { "type": "collection_card", "settings": { "label": "TEES" } },
        { "type": "collection_card", "settings": { "label": "CAPS" } },
        { "type": "collection_card", "settings": { "label": "OUTERWEAR" } }
      ]
    }
  ]
}
{% endschema %}
