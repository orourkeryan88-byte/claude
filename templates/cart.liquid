<div class="cart-page">
  <h1>Your Cart</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div class="cart-item" data-reveal="up" data-reveal-delay="{{ forloop.index | times: 100 }}">

          <div class="cart-item-image">
            {%- if item.image -%}
              <a href="{{ item.url }}">
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | default: item.title | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              </a>
            {%- endif -%}
          </div>

          <div class="cart-item-details">
            <p class="cart-item-name">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
            </p>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}

            <div class="qty-control">
              <button class="qty-btn" type="button" data-action="dec"
                onclick="this.closest('.qty-control').querySelector('.qty-value').textContent = Math.max(1, parseInt(this.closest('.qty-control').querySelector('.qty-value').textContent) - 1)">
                &minus;
              </button>
              <span class="qty-value">{{ item.quantity }}</span>
              <button class="qty-btn" type="button" data-action="inc"
                onclick="this.closest('.qty-control').querySelector('.qty-value').textContent = parseInt(this.closest('.qty-control').querySelector('.qty-value').textContent) + 1">
                &#43;
              </button>
            </div>
          </div>

          <div>
            <p style="font-weight:700;font-size:16px;">{{ item.final_line_price | money }}</p>
            <a href="/cart/change?line={{ forloop.index }}&quantity=0"
               style="font-size:12px;color:#999;text-decoration:underline;display:block;margin-top:8px;">
              Remove
            </a>
          </div>

        </div>
      {%- endfor -%}

      <div class="cart-summary">
        <div class="cart-total">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size:13px;color:#666;margin-bottom:20px;">
          Shipping & taxes calculated at checkout.
        </p>
        <button type="submit" name="checkout" class="btn btn--primary" style="width:100%;justify-content:center;padding:18px;">
          Checkout
        </button>
        <a href="/collections/all" class="btn btn--outline" style="width:100%;justify-content:center;margin-top:12px;">
          Continue Shopping
        </a>
      </div>
    {%- endform -%}

  {%- else -%}
    <div class="empty-state">
      <p style="font-size:16px;color:#666;margin-bottom:36px;">Your cart is empty.</p>
      <a href="/collections/all" class="btn btn--primary">Shop Now</a>
    </div>
  {%- endif -%}
</div>
