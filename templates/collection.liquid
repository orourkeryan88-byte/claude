<div class="collection-header">
  <p class="section-label" data-reveal="fade">{{ collection.title }}</p>
  <h1 class="section-title" data-reveal="up" data-reveal-delay="100">
    {{ collection.title }}
  </h1>
  {%- if collection.description != blank -%}
    <p class="section-desc" data-reveal="up" data-reveal-delay="200">{{ collection.description }}</p>
  {%- endif -%}
</div>

<div class="collection-body">
  {%- paginate collection.products by 12 -%}
    <div class="collection-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product, index: forloop.index0 -%}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="display:flex;justify-content:center;gap:8px;margin-top:60px;">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="btn btn--outline" style="min-width:48px;justify-content:center;">{{ part.title }}</a>
          {%- else -%}
            <span class="btn btn--primary" style="min-width:48px;justify-content:center;">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>
