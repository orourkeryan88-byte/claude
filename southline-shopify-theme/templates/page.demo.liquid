{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Previous Work | Fibre Optic &amp; Structured Cabling Concept — Dublin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #060c18;
      --panel:  #0c1526;
      --blue:   #102140;
      --accent: #22d3ee;
      --accent2:#0ea5e9;
      --light:  #cfe8f5;
      --white:  #ffffff;
      --grey:   #8aa0b8;
      --bg:     #f4f8fb;
      --card:   #ffffff;
      --border: #e1e8ef;
      --text:   #142233;
      --radius: 12px;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    /* ── NAV ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: var(--navy);
      padding: 0 24px;
      display: flex; align-items: center; justify-content: space-between;
      height: 68px;
      box-shadow: 0 2px 16px rgba(0,0,0,.35);
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; }
    .nav-logo .drop {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; color: var(--navy); font-size: 16px; letter-spacing: -.5px;
    }
    .nav-logo span { font-size: 1.08rem; font-weight: 700; color: var(--white); letter-spacing: .3px; }
    .nav-logo small { display: block; font-size: .68rem; color: var(--light); font-weight: 500; letter-spacing: 1.5px; }
    /* ── HERO ── */
    .hero {
      background:
        radial-gradient(ellipse at 20% 20%, rgba(34,211,238,.12), transparent 55%),
        linear-gradient(160deg, var(--navy) 0%, var(--blue) 100%);
      color: var(--white);
      padding: 84px 24px 96px;
      text-align: center;
      position: relative; overflow: hidden;
    }
    .hero::after {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(34,211,238,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34,211,238,.06) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,.7), transparent 70%);
    }
    .hero-inner { position: relative; max-width: 740px; margin: 0 auto; }
    .badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(34,211,238,.12);
      border: 1px solid rgba(34,211,238,.35);
      color: var(--accent);
      font-size: .78rem; font-weight: 700; letter-spacing: 1.2px;
      padding: 6px 16px; border-radius: 20px; margin-bottom: 26px; text-transform: uppercase;
    }
    .dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; animation: pulse 1.8s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.5)} }
    .hero h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.12; letter-spacing: -1px; }
    .hero h1 .accent { color: var(--accent); }
    .hero p.sub { font-size: 1.14rem; color: var(--light); max-width: 540px; margin: 22px auto 38px; }
    .hero-stats { display: flex; gap: 36px; justify-content: center; flex-wrap: wrap; margin-top: 56px; padding-top: 38px; border-top: 1px solid rgba(255,255,255,.12); }
    .hero-stat strong { display: block; font-size: 1.8rem; font-weight: 800; color: var(--accent); }
    .hero-stat span { font-size: .82rem; color: var(--light); }

    /* ── TRUST BAR ── */
    .trust-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 16px 24px; }
    .trust-inner { max-width: 980px; margin: 0 auto; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
    .trust-chip {
      display: flex; align-items: center; gap: 6px;
      background: var(--bg); border: 1px solid var(--border);
      padding: 7px 14px; border-radius: 20px; font-size: .82rem; font-weight: 600; color: var(--text);
    }

    /* ── SECTION ── */
    section { padding: 76px 24px; }
    .section-inner { max-width: 980px; margin: 0 auto; }
    .section-label { font-size: .74rem; font-weight: 700; letter-spacing: 2px; color: var(--accent2); text-transform: uppercase; margin-bottom: 10px; }
    .section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--text); margin-bottom: 12px; }
    .section-sub { font-size: 1rem; color: var(--grey); max-width: 540px; }

    /* ── SERVICES ── */
    .services-bg { background: var(--bg); }
    .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; margin-top: 40px; }
    .service-card {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 26px 22px; transition: border-color .2s, transform .2s, box-shadow .2s;
    }
    .service-card:hover { border-color: var(--accent2); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(14,165,233,.1); }
    .service-icon {
      font-size: 1.8rem; margin-bottom: 14px; width: 52px; height: 52px;
      background: var(--blue); border-radius: 10px; color: var(--accent);
      display: flex; align-items: center; justify-content: center;
    }
    .service-card h3 { font-size: .98rem; font-weight: 700; margin-bottom: 6px; }
    .service-card p { font-size: .85rem; color: var(--grey); }

    /* ── ABOUT ── */
    .about-bg { background: linear-gradient(160deg, var(--navy) 0%, var(--blue) 100%); color: var(--white); }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    .about-bg .section-label { color: var(--accent); }
    .about-bg .section-title { color: var(--white); }
    .about-text p { color: var(--light); margin-bottom: 16px; font-size: .97rem; line-height: 1.75; }
    .about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .about-stat { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius); padding: 22px; text-align: center; }
    .about-stat strong { display: block; font-size: 1.8rem; font-weight: 800; color: var(--accent); margin-bottom: 4px; }
    .about-stat span { font-size: .8rem; color: var(--light); }
    @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }

    /* ── WHY ── */
    .why-bg { background: var(--white); }
    .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
    .why-card { padding: 4px; }
    .why-card .num { font-family: ui-monospace, monospace; font-size: 2.2rem; font-weight: 800; color: var(--border); margin-bottom: 6px; }
    .why-card h3 { font-size: 1.02rem; margin-bottom: 8px; }
    .why-card p { font-size: .9rem; color: var(--grey); }
    @media (max-width: 760px) { .why-grid { grid-template-columns: 1fr; } }

    /* ── FOOTER ── */
    footer { background: var(--navy); color: var(--light); text-align: center; padding: 30px 24px; font-size: .82rem; }
    footer a { color: var(--accent); text-decoration: none; }

    @media (max-width: 480px) {
      .hero { padding: 60px 20px 70px; }
      .hero-stats { gap: 22px; }
      section { padding: 56px 20px; }
    }
  </style>
</head>
<body>

