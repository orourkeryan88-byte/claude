<footer class="site-footer" role="contentinfo" style="background:{{ section.settings.bg_color }};">
  <div class="footer-inner">

    <div class="footer-top" style="grid-template-columns:{{ section.settings.logo_col_width }}px {% for i in (1..section.blocks.size) %}1fr {% endfor %};">

      <!-- Brand column -->
      <div class="footer-logo">
        <a href="/" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ section.settings.logo.alt | default: shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
            >
          {%- else -%}
            <span class="brand-name" style="color:{{ section.settings.logo_color }};">
              {{ section.settings.brand_name | default: 'RELIER' }}
            </span><br>
            <span class="brand-sub" style="color:{{ section.settings.logo_sub_color }};">
              {{ section.settings.brand_sub | default: 'Clothing' }}
            </span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p style="font-size:13px;color:{{ section.settings.footer_text_color }};margin-top:16px;line-height:1.6;max-width:200px;">
            {{ section.settings.tagline }}
          </p>
        {%- endif -%}
      </div>

      <!-- Link column blocks -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4 style="color:{{ section.settings.footer_heading_color }};">{{ block.settings.heading }}</h4>
            <ul>
              {%- if block.settings.linklist != blank and linklists[block.settings.linklist].links.size > 0 -%}
                {%- for link in linklists[block.settings.linklist].links -%}
                  <li>
                    <a href="{{ link.url }}" style="color:{{ section.settings.footer_link_color }};">
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- assign links = block.settings.custom_links | split: ',' -%}
                {%- assign labels = block.settings.custom_labels | split: ',' -%}
                {%- for link in links -%}
                  <li>
                    <a href="{{ link | strip }}" style="color:{{ section.settings.footer_link_color }};">
                      {{ labels[forloop.index0] | strip | default: link | strip }}
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>

        {%- elsif block.type == 'social' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4 style="color:{{ section.settings.footer_heading_color }};">{{ block.settings.heading | default: 'Follow Us' }}</h4>
            <div class="footer-social">
              {%- if block.settings.instagram != blank -%}
                <a href="{{ block.settings.instagram }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.tiktok != blank -%}
                <a href="{{ block.settings.tiktok }}" class="social-link" aria-label="TikTok" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.84a8.23 8.23 0 0 0 4.83 1.55V6.94a4.85 4.85 0 0 1-1.06-.25z"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.twitter != blank -%}
                <a href="{{ block.settings.twitter }}" class="social-link" aria-label="X / Twitter" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.youtube != blank -%}
                <a href="{{ block.settings.youtube }}" class="social-link" aria-label="YouTube" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.5v-7l6.5 3.5z"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <a href="mailto:{{ block.settings.email }}" class="social-link" aria-label="Email">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- elsif block.type == 'text' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h4 style="color:{{ section.settings.footer_heading_color }};">{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <p style="font-size:14px;line-height:1.7;color:{{ section.settings.footer_text_color }};">
                {{ block.settings.content }}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <p style="color:{{ section.settings.footer_copyright_color }};">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: shop.name }}. {{ section.settings.rights_text | default: 'All rights reserved' }}
      </p>
      <div class="footer-legal">
        {%- if section.settings.show_terms -%}
          <a href="/policies/terms-of-service" style="color:{{ section.settings.footer_copyright_color }};">Terms of Service</a>
        {%- endif -%}
        {%- if section.settings.show_privacy -%}
          <a href="/policies/privacy-policy" style="color:{{ section.settings.footer_copyright_color }};">Privacy Policy</a>
        {%- endif -%}
        {%- if section.settings.show_refund -%}
          <a href="/policies/refund-policy" style="color:{{ section.settings.footer_copyright_color }};">Refund Policy</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_col_width",
      "min": 120,
      "max": 280,
      "step": 20,
      "unit": "px",
      "label": "Logo column width",
      "default": 200
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (text fallback)",
      "default": "RELIER"
    },
    {
      "type": "text",
      "id": "brand_sub",
      "label": "Brand tagline",
      "default": "Clothing"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Footer tagline below logo"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright name (defaults to shop name)"
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Rights text",
      "default": "All rights reserved"
    },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "Show Terms of Service link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "Show Privacy Policy link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_refund",
      "label": "Show Refund Policy link",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "logo_sub_color",
      "label": "Logo tagline color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "footer_heading_color",
      "label": "Column heading color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "footer_link_color",
      "label": "Link color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "label": "Text color",
      "default": "#aaaaaa"
    },
    {
      "type": "color",
      "id": "footer_copyright_color",
      "label": "Copyright color",
      "default": "#555555"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "linklist",
          "label": "Navigation menu",
          "info": "Select a menu, or enter custom links below"
        },
        {
          "type": "textarea",
          "id": "custom_links",
          "label": "Custom link URLs (comma-separated)",
          "info": "e.g. /collections/all, /pages/about"
        },
        {
          "type": "textarea",
          "id": "custom_labels",
          "label": "Custom link labels (comma-separated)",
          "info": "e.g. All Caps, About Us"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Follow Us"
        },
        {
          "type": "url",
          "id": "instagram",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "tiktok",
          "label": "TikTok URL"
        },
        {
          "type": "url",
          "id": "twitter",
          "label": "X / Twitter URL"
        },
        {
          "type": "url",
          "id": "youtube",
          "label": "YouTube URL"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email address"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
