<div style="max-width:{{ section.settings.content_width }}px;margin:0 auto;padding:{{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;">

  {%- if section.settings.show_title -%}
    <h1 class="section-title" data-reveal="up" style="margin-bottom:{{ section.settings.title_margin }}px;color:{{ section.settings.heading_color }};">
      {{ page.title }}
    </h1>
  {%- endif -%}

  <div class="product-desc" data-reveal="up" data-reveal-delay="100" style="color:{{ section.settings.text_color }};max-width:{{ section.settings.text_width }}px;">
    {{ page.content }}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'image' -%}
      {%- if block.settings.image != blank -%}
        <div style="margin:{{ block.settings.margin }}px 0;" {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt }}"
            style="width:100%;border-radius:{{ block.settings.border_radius }}px;"
            loading="lazy"
          >
        </div>
      {%- endif -%}

    {%- elsif block.type == 'custom_liquid' -%}
      <div style="margin:32px 0;" {{ block.shopify_attributes }}>
        {{ block.settings.custom_liquid }}
      </div>
    {%- endif -%}
  {%- endfor -%}

</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_margin",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Title bottom margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 480,
      "max": 1280,
      "step": 40,
      "unit": "px",
      "label": "Max content width",
      "default": 800
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 400,
      "max": 900,
      "step": 40,
      "unit": "px",
      "label": "Max text width",
      "default": 680
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "margin",
          "min": 8,
          "max": 80,
          "step": 4,
          "unit": "px",
          "label": "Top & bottom margin",
          "default": 32
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "label": "Border radius",
          "default": 0
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid"
        }
      ]
    }
  ]
}
{% endschema %}
