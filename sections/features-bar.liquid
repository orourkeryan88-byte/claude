<div class="features-bar">
  <div class="features-inner">

    <div class="feature-item" data-reveal="up" data-reveal-delay="100">
      <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="16" width="40" height="20" rx="2"/>
        <path d="M12 16V12a4 4 0 0 1 8 0v4"/>
        <circle cx="36" cy="32" r="2"/>
        <path d="M4 24h40"/>
      </svg>
      <div class="feature-text">
        <strong>{{ section.settings.feat1_title | default: 'Fast Shipping' }}</strong>
        <span>{{ section.settings.feat1_desc | default: 'Quick & reliable delivery' }}</span>
      </div>
    </div>

    <div class="features-divider" aria-hidden="true"></div>

    <div class="feature-item" data-reveal="up" data-reveal-delay="250">
      <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 4L6 12v14c0 10 8 18 18 22 10-4 18-12 18-22V12L24 4z"/>
        <polyline points="16 24 21 29 32 18"/>
      </svg>
      <div class="feature-text">
        <strong>{{ section.settings.feat2_title | default: 'Premium Quality' }}</strong>
        <span>{{ section.settings.feat2_desc | default: 'Built to last. Made to wear.' }}</span>
      </div>
    </div>

    <div class="features-divider" aria-hidden="true"></div>

    <div class="feature-item" data-reveal="up" data-reveal-delay="400">
      <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="10" y="20" width="28" height="22" rx="2"/>
        <path d="M16 20V14a8 8 0 0 1 16 0v6"/>
        <circle cx="24" cy="31" r="2"/>
        <line x1="24" y1="33" x2="24" y2="37"/>
      </svg>
      <div class="feature-text">
        <strong>{{ section.settings.feat3_title | default: 'Secure Checkout' }}</strong>
        <span>{{ section.settings.feat3_desc | default: '100% safe & secure' }}</span>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Features Bar",
  "settings": [
    { "type": "text", "id": "feat1_title", "label": "Feature 1 title", "default": "Fast Shipping" },
    { "type": "text", "id": "feat1_desc",  "label": "Feature 1 description", "default": "Quick & reliable delivery" },
    { "type": "text", "id": "feat2_title", "label": "Feature 2 title", "default": "Premium Quality" },
    { "type": "text", "id": "feat2_desc",  "label": "Feature 2 description", "default": "Built to last. Made to wear." },
    { "type": "text", "id": "feat3_title", "label": "Feature 3 title", "default": "Secure Checkout" },
    { "type": "text", "id": "feat3_desc",  "label": "Feature 3 description", "default": "100% safe & secure" }
  ],
  "presets": [
    { "name": "Features Bar", "category": "Content" }
  ]
}
{% endschema %}
