<div class="features-bar" style="background:{{ section.settings.bg_color }};">
  <div class="features-inner">

    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}
        <div class="features-divider" aria-hidden="true" style="background:{{ section.settings.divider_color }};"></div>
      {%- endunless -%}

      <div class="feature-item" data-reveal="up" data-reveal-delay="{{ forloop.index | times: 150 }}" {{ block.shopify_attributes }}>

        {%- if block.settings.icon == 'shipping' -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="15" width="30" height="22" rx="2"/>
            <path d="M31 20h8l6 8v9h-14V20z"/>
            <circle cx="11" cy="40" r="3"/><circle cx="38" cy="40" r="3"/>
          </svg>
        {%- elsif block.settings.icon == 'quality' -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M24 4L6 12v14c0 10 8 18 18 22 10-4 18-12 18-22V12L24 4z"/>
            <polyline points="16 24 21 29 32 18"/>
          </svg>
        {%- elsif block.settings.icon == 'lock' -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="10" y="20" width="28" height="22" rx="2"/>
            <path d="M16 20V14a8 8 0 0 1 16 0v6"/>
            <circle cx="24" cy="31" r="2"/>
            <line x1="24" y1="33" x2="24" y2="37"/>
          </svg>
        {%- elsif block.settings.icon == 'returns' -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 16 13 16"/>
            <path d="M4.4 28a18 18 0 1 0 1.1-9.2"/>
          </svg>
        {%- elsif block.settings.icon == 'star' -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="24 4 29.5 18.3 45 20.3 34 31 37 46 24 38.8 11 46 14 31 3 20.3 18.5 18.3 24 4"/>
          </svg>
        {%- else -%}
          <svg class="feature-icon" viewBox="0 0 48 48" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="24" cy="24" r="20"/>
            <polyline points="16 24 21 29 32 18"/>
          </svg>
        {%- endif -%}

        <div class="feature-text">
          <strong style="color:{{ section.settings.title_color }};">{{ block.settings.title }}</strong>
          <span style="color:{{ section.settings.desc_color }};">{{ block.settings.description }}</span>
        </div>

      </div>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      <p style="color:rgba(255,255,255,0.5);font-size:13px;">Add features using the theme editor.</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Features Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#999999"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping truck" },
            { "value": "quality",  "label": "Quality shield" },
            { "value": "lock",     "label": "Security lock" },
            { "value": "returns",  "label": "Returns arrow" },
            { "value": "star",     "label": "Star" },
            { "value": "check",    "label": "Checkmark" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description here."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Features Bar",
      "category": "Content",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shipping",
            "title": "Fast Shipping",
            "description": "Quick & reliable delivery"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "quality",
            "title": "Premium Quality",
            "description": "Built to last. Made to wear."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "lock",
            "title": "Secure Checkout",
            "description": "100% safe & secure"
          }
        }
      ]
    }
  ]
}
{% endschema %}
