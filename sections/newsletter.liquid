<section
  class="newsletter-section"
  style="background:{{ section.settings.bg_color }};border-top-color:{{ section.settings.border_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="newsletter-inner">

    <div class="newsletter-content" data-reveal="left">
      {%- if section.settings.label != blank -%}
        <p class="section-label" style="text-align:left;color:{{ section.settings.label_color }};">
          {{ section.settings.label }}
        </p>
      {%- endif -%}
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p style="color:{{ section.settings.desc_color }};">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', id: 'newsletter-form' -%}
      <div class="newsletter-form" data-reveal="right">
        <input type="hidden" name="contact[tags]" value="newsletter">

        <label for="newsletter-email-{{ section.id }}" class="visually-hidden">Email address</label>
        <input
          id="newsletter-email-{{ section.id }}"
          class="newsletter-input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
          autocomplete="email"
          required
          style="border-color:{{ section.settings.input_border_color }};color:{{ section.settings.heading_color }};background:{{ section.settings.input_bg_color }};"
        >
        <button
          type="submit"
          class="newsletter-submit"
          style="background:{{ section.settings.btn_bg_color }};color:{{ section.settings.btn_text_color }};border-color:{{ section.settings.btn_bg_color }};"
        >
          {{ section.settings.submit_text | default: 'Subscribe' }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="newsletter-success" style="color:{{ section.settings.heading_color }};margin-top:12px;font-size:14px;">
          {{ section.settings.success_message | default: "Thanks for subscribing!" }}
        </p>
      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Join the Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be the First to Know"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get early access to new drops, restocks and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top border color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
